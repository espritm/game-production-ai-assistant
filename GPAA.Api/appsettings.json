{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Root": ".gpaa/indexes"
  },
  "Chat": {
    "Provider": "Ollama"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "erwan2/DeepSeek-R1-Distill-Qwen-7B:latest",
    "EmbeddingModel": "nomic-embed-text",
    "ChatTimeoutSeconds": 240,
    "ChatMaxOutputTokens": 192,
    "ChatResponseBudgetSeconds": 90,
    "UseOllamaEmbeddings": true,
    "UseOllamaChat": true
  },
  "OpenAICompatible": {
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4.1-mini",
    "ApiKey": "",
    "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
    "TimeoutSeconds": 120,
    "MaxOutputTokens": 512,
    "Temperature": 0.2
  }
}
